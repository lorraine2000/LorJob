{
  "name": "jobi",
  "module": "index.ts",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@types/bun": "latest",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.12.0"
  },
  "scripts": {
    "api:dev": "bun run --cwd apps/api dev",
    "api:build": "bun run --cwd apps/api build",
    "api:start": "bun run --cwd apps/api prod",
    "platform:dev": "bun run --cwd apps/platform dev",
    "platform:build": "bun run --cwd apps/platform build",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force && prisma generate  && prisma migrate dev",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "docker:dev": "docker compose --file docker-compose.dev.yml --env-file .env up --build"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": ["@prisma/client", "@prisma/engines", "prisma"],
  "packageManager": "bun@1.2.15",
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@prisma/client": "6.12.0"
  }
}